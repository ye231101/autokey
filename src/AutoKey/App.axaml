<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AutoKey.App"
             Name="AutoKey"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="CardBackground" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="CardBorder" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="SecondaryText" Color="#5D5D5D" />
                    <SolidColorBrush x:Key="TertiaryText" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="AccentText" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="StatusIdle" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="StatusWaiting" Color="#9D5D00" />
                    <SolidColorBrush x:Key="StatusSuccess" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="StatusError" Color="#C42B1C" />
                    <SolidColorBrush x:Key="NoticeBackground" Color="#FFF4CE" />
                    <SolidColorBrush x:Key="NoticeBorder" Color="#F0DEA1" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#202020" />
                    <SolidColorBrush x:Key="CardBackground" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="CardBorder" Color="#363636" />
                    <SolidColorBrush x:Key="SecondaryText" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="TertiaryText" Color="#8B8B8B" />
                    <SolidColorBrush x:Key="AccentText" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="StatusIdle" Color="#8B8B8B" />
                    <SolidColorBrush x:Key="StatusWaiting" Color="#FCE100" />
                    <SolidColorBrush x:Key="StatusSuccess" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="StatusError" Color="#FF99A4" />
                    <SolidColorBrush x:Key="NoticeBackground" Color="#433519" />
                    <SolidColorBrush x:Key="NoticeBorder" Color="#5C4A22" />
                    <!-- Fluent's dark text box turns pure black when focused; keep it in the card's family of greys. -->
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1F1F1F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 16×16 icons, drawn as vector paths so they look the same on every OS. -->
            <StreamGeometry x:Key="PlayIcon">M5,3.2 C5,2.6 5.6,2.3 6.1,2.6 L13.2,7.4 C13.6,7.7 13.6,8.3 13.2,8.6 L6.1,13.4 C5.6,13.7 5,13.4 5,12.8 Z</StreamGeometry>
            <StreamGeometry x:Key="PauseIcon">M4.5,3 H6.5 C6.8,3 7,3.2 7,3.5 V12.5 C7,12.8 6.8,13 6.5,13 H4.5 C4.2,13 4,12.8 4,12.5 V3.5 C4,3.2 4.2,3 4.5,3 Z M9.5,3 H11.5 C11.8,3 12,3.2 12,3.5 V12.5 C12,12.8 11.8,13 11.5,13 H9.5 C9.2,13 9,12.8 9,12.5 V3.5 C9,3.2 9.2,3 9.5,3 Z</StreamGeometry>
            <StreamGeometry x:Key="StopIcon">M4.5,3.5 H11.5 C12.05,3.5 12.5,3.95 12.5,4.5 V11.5 C12.5,12.05 12.05,12.5 11.5,12.5 H4.5 C3.95,12.5 3.5,12.05 3.5,11.5 V4.5 C3.5,3.95 3.95,3.5 4.5,3.5 Z</StreamGeometry>
            <StreamGeometry x:Key="ClearIcon">M3.6,2.9 L8,7.3 L12.4,2.9 L13.1,3.6 L8.7,8 L13.1,12.4 L12.4,13.1 L8,8.7 L3.6,13.1 L2.9,12.4 L7.3,8 L2.9,3.6 Z</StreamGeometry>
            <StreamGeometry x:Key="PasteIcon">F1 M4.5,2.5 H11.5 C12.33,2.5 13,3.17 13,4 V13.5 C13,14.33 12.33,15 11.5,15 H4.5 C3.67,15 3,14.33 3,13.5 V4 C3,3.17 3.67,2.5 4.5,2.5 Z M4.5,3.5 C4.22,3.5 4,3.72 4,4 V13.5 C4,13.78 4.22,14 4.5,14 H11.5 C11.78,14 12,13.78 12,13.5 V4 C12,3.72 11.78,3.5 11.5,3.5 Z M6,1.5 H10 C10.28,1.5 10.5,1.72 10.5,2 V4 C10.5,4.28 10.28,4.5 10,4.5 H6 C5.72,4.5 5.5,4.28 5.5,4 V2 C5.5,1.72 5.72,1.5 6,1.5 Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.notice">
            <Setter Property="Background" Value="{DynamicResource NoticeBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NoticeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.strong">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.value">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        </Style>

        <Style Selector="Grid.setting">
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>

        <!-- Fluent sliders reserve a lot of vertical space; keep each setting compact. -->
        <Style Selector="Slider:horizontal">
            <Setter Property="Margin" Value="0,-6,0,-10" />
        </Style>

        <!-- The coloured dot that shows what the typing session is doing. -->
        <Style Selector="Ellipse.status">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{DynamicResource StatusIdle}" />
        </Style>
        <Style Selector="Ellipse.status.active">
            <Setter Property="Fill" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Ellipse.status.waiting">
            <Setter Property="Fill" Value="{DynamicResource StatusWaiting}" />
        </Style>
        <Style Selector="Ellipse.status.success">
            <Setter Property="Fill" Value="{DynamicResource StatusSuccess}" />
        </Style>
        <Style Selector="Ellipse.status.error">
            <Setter Property="Fill" Value="{DynamicResource StatusError}" />
        </Style>
    </Application.Styles>
</Application>
